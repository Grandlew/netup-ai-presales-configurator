APP_ENV=development
DATABASE_URL=sqlite:///./netup_presales.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_MESSAGE_LENGTH=2000
BANDWIDTH_OVERHEAD_PERCENT=12
BANDWIDTH_SAFETY_MARGIN_PERCENT=20
ARCHIVE_OVERHEAD_PERCENT=10
ARCHIVE_SAFETY_MARGIN_PERCENT=15
ARCHIVE_REDUNDANCY_FACTOR=1.0
ARCHIVE_RECORDING_RATIO=1.0
REPORT_OUTPUT_DIR=generated_reports
PRODUCT_RULES_PATH=config/product_rules.yaml
DATA_RETENTION_NOTE=Lead data is stored for presales follow-up and must be handled under your applicable privacy policy.
